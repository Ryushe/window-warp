{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Window Warp",
  "version": "0.1.0",
  "identifier": "com.windowwarp.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Window Warp", "width": 1050, "height": 760, "minWidth": 760, "minHeight": 560 },
      { "label": "radial", "title": "Window Warp Picker", "url": "radial.html", "width": 260, "height": 260, "visible": false, "focus": false, "decorations": false, "resizable": false, "alwaysOnTop": true, "skipTaskbar": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico"],
    "linux": {"deb": {"desktopTemplate": "linux.desktop.hbs"}, "rpm": {"desktopTemplate": "linux.desktop.hbs"}} }
}
