# Disposable native KDE test desktop; no access to the host's seat or session bus.
# Build tests/kde/Dockerfile as window-warp-build:local first.
FROM window-warp-build:local
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    kwin-wayland kwin-wayland-backend-virtual qdbus-qt5 qtwayland5 \
    python3-pyqt5 dbus-x11 webkit2gtk-driver procps libgl1-mesa-dri \
    fonts-dejavu-core xvfb xauth && rm -rf /var/lib/apt/lists/*
# The virtual backend needs no resource-limit privilege. File capabilities would
# prevent execution under Docker's normal capability bounding set.
RUN setcap -r /usr/bin/kwin_wayland
# KWin's fallback QML decoration needs a full Plasma shell. Use its normal native
# Breeze decoration in the standalone test desktop instead.
RUN apt-get update && apt-get install -y --no-install-recommends kwin-style-breeze \
    && rm -rf /var/lib/apt/lists/*
USER 1000:1000
ENV HOME=/tmp QT_SELECT=qt5
ENV PATH=/usr/lib/qt5/bin:$PATH
CMD ["dbus-run-session", "--", "bash", "tests/kde/nested.sh", "/work", "--gui", "/work/src-tauri/target/release/window-warp", "/usr/bin/WebKitWebDriver", "/work/src-tauri/target/kde-container", "--hold", "--pointer", "--radial"]
